# =============================================================
# oct-batch2 — root .gitignore
# Covers: Swift/Xcode (NPay, SDK-provider), React Native (NPayRN),
# Spring Boot/Maven (server), HTML slide decks, lab guides.
# Sub-projects may add their own .gitignore on top of this.
# =============================================================

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# ---------- Xcode ----------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.hmap
DerivedData/
build/
**/.xcode.env.local

# App packaging / symbols
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# ---------- Swift Package Manager ----------
.build/
.swiftpm/
/Packages/

# ---------- CocoaPods / Carthage / Ruby ----------
Pods/
Carthage/Build/
Carthage/Checkouts/
vendor/bundle/
.bundle/

# ---------- fastlane ----------
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ---------- Node / React Native ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.metro-health-check*
*.jsbundle
/coverage
coverage/
.expo/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------- Android ----------
.gradle/
local.properties
.cxx/
.kotlin/
*.apk
*.aab
*.hprof
captures/
*.keystore
!debug.keystore

# ---------- Java / Maven / Spring Boot ----------
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
HELP.md
*.class

# ---------- IDEs / editors ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.factorypath
.sts4-cache/
*.swp
*.swo
*~

# ---------- Secrets & local env ----------
.env
.env.*
!.env.example
*.mobileprovision
*.provisionprofile
GoogleService-Info.plist
google-services.json
# NOTE: npay-workshop/certs/*.p12 are intentional demo-only certs — kept.

# ---------- Logs / temp ----------
*.log
!npay-workshop/evidence/*.log
*.tmp
tmp/
.cache/
