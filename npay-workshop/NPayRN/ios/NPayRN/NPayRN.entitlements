<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (Labs 5–6). "development" = APNs sandbox; distribution builds get "production". -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Groups (Lab 8): a shared container the app and its widget can both read. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.npay.workshop</string>
	</array>
</dict>
</plist>
